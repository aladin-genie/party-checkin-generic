# Party Check-In Generic — Streamlit Secrets (local example)
# DO NOT commit the real .streamlit/secrets.toml to version control!
# On Streamlit Community Cloud, set these via Dashboard → Settings → Secrets.
#
# NOTE: Streamlit reads this file relative to the CURRENT WORKING DIRECTORY.
# If you point DATABASE_URL at production and run the app from this folder,
# you will be writing to the live guest list and sending real email.

SECRET_KEY = "your-long-random-secret-key-here"

# Local development: SQLite. Production: the Supabase POOLER connection string.
DATABASE_URL = "sqlite:///party_guests.db"

# Public URL of the deployed app — used for the "view your QR" link in emails.
APP_URL = "https://party-checkin-generic.streamlit.app"

# Email (Gmail SMTP example).
# Leave MAIL_USERNAME/MAIL_PASSWORD blank to disable outgoing email entirely —
# registration still works, guests just don't get an automatic QR email.
MAIL_SERVER = "smtp.gmail.com"
MAIL_PORT = "587"
MAIL_USERNAME = ""
MAIL_PASSWORD = ""            # Gmail *app password*, not your normal password
MAIL_DEFAULT_SENDER = "your-email@gmail.com"

# Admin password for the dashboard.
# REQUIRED: verification fails closed, so if this is unset nobody can log in.
ADMIN_PASSWORD = "change-me"

# Hard cap on tickets sold across all guests. Once this many are claimed the
# Register page shows a sold-out screen. Set to "0" to remove the cap.
MAX_TOTAL_TICKETS = "225"

# Zelle payment info shown to guests on the registration page.
ZELLE_INFO = "dfwygana@gmail.com"
